            # Clear first so imported data doesn't silently mix with stale live data.
            database.clear_db()
            proc = subprocess.run(["sudo", sys.executable, "sniffer.py", "-r", temp_pcap])
            st.sidebar.success("PCAP imported — live data cleared and replaced. Dashboard will update.")
            st.rerun()

