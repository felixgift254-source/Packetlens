# ── Geo-Location Map ──────────────────────────────────────────────────────────
st.subheader("🌍 Destination IP Locations")

# Fix #4: cache the full locations list; only re-query IPs we haven't seen before
@st.cache_data(show_spinner=False, max_entries=1)
def build_locations(ip_tuple: tuple) -> list:
    """Re-runs only when the set of unique destination IPs changes."""
    results = []
    for ip in ip_tuple:
        loc = get_ip_location(ip)
        if loc:
            results.append({"ip": ip, "lat": loc[0], "lon": loc[1], "country": loc[2], "city": loc[3]})
    return results

unique_dst_ips = tuple(sorted(df["dst_ip"].unique()))
locations = build_locations(unique_dst_ips)

if locations:
    map_df = pd.DataFrame(locations)
    fig_map = px.scatter_geo(
        map_df, lat="lat", lon="lon",
        hover_name="ip", hover_data={"city": True, "country": True, "lat": False, "lon": False},
        projection="natural earth",
        size_max=15,
    )
    fig_map.update_traces(marker=dict(size=10, color="#FF4B4B", line=dict(width=1, color="white")))
    fig_map.update_layout(
        template="plotly_dark",
        margin=dict(l=0, r=0, t=30, b=0),
        geo=dict(bgcolor="#0e1117", showland=True, landcolor="#1a1d23",
                 showocean=True, oceancolor="#0e1117",
                 showcountries=True, countrycolor="#444"),
    )
    st.plotly_chart(fig_map, use_container_width=True)
else:
    st.info("No public destination IPs resolved yet. Geo-location populates as packets flow in.")

