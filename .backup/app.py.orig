st.markdown("---")

# ── Security Alerts & Threat Intelligence ─────────────────────────────────────
st.subheader("🚨 Security Intel & Alerts")
alert_col, track_col = st.columns([1, 1])

with alert_col:
    # 1. Suspicious Port Alerting
    suspicious_ports = {4444: "Metasploit", 1337: "Leet", 31337: "BackOrifice", 6667: "IRC/Botnet"}
    suspicious_traffic = df[df["dst_port"].isin(suspicious_ports) | df["src_port"].isin(suspicious_ports)]
    for _, row in suspicious_traffic.drop_duplicates(subset=["src_ip", "dst_ip", "dst_port"]).iterrows():
        port = row["dst_port"] if row["dst_port"] in suspicious_ports else row["src_port"]
        st.error(f"🔴 **Suspicious Port Activity**: `{row['src_ip']}` ↔ `{row['dst_ip']}` on Port **{port}** ({suspicious_ports[port]})")

    # 2. Port Scan Detector
    scan_threshold = 15
    port_scans = df.groupby("src_ip")["dst_port"].nunique().reset_index()
    scanners = port_scans[port_scans["dst_port"] > scan_threshold]
    for _, row in scanners.iterrows():
        st.error(f"🔴 **Possible Port Scan**: `{row['src_ip']}` accessed **{row['dst_port']}** unique ports.")
        
    # 3. Known Bad IP Lookup (Mock Threat Feed)
    mock_bad_ips = ["185.159.82.15", "45.144.225.10", "193.163.125.138"]
    bad_traffic = df[df["src_ip"].isin(mock_bad_ips) | df["dst_ip"].isin(mock_bad_ips)]
    for _, row in bad_traffic.drop_duplicates(subset=["src_ip", "dst_ip"]).iterrows():
        bad_ip = row["src_ip"] if row["src_ip"] in mock_bad_ips else row["dst_ip"]
        st.error(f"🔴 **Malicious IP Detected**: `{bad_ip}` is on the Threat Intelligence Blocklist.")

    # 4. ML Anomaly Detection (Expanded Features)
    ml_data = df.groupby("src_ip").agg(
        packet_count=("id", "count"),
        avg_payload_size=("length", "mean"),
        unique_ports=("dst_port", "nunique")
    ).reset_index()

    # Fix #1: pre-initialise anomalies so the "all-clear" check never raises NameError
    anomalies = pd.DataFrame()
    if len(ml_data) >= 5:
        model = IsolationForest(contamination=0.05, random_state=42)
        ml_data["anomaly"] = model.fit_predict(ml_data[["packet_count", "avg_payload_size", "unique_ports"]])
        anomalies = ml_data[ml_data["anomaly"] == -1]
        for _, row in anomalies.iterrows():
            st.warning(
                f"🤖 **ML Anomaly Detected**: `{row['src_ip']}` "
                f"(Pkts: {row['packet_count']} | Avg Size: {row['avg_payload_size']:.0f} B | Ports: {row['unique_ports']})"
            )

    if suspicious_traffic.empty and scanners.empty and bad_traffic.empty and anomalies.empty:
        st.success("✅ No security threats detected.")

with track_col:
    # 5. Connection Tracking (TCP States)
    if "tcp_flags" in df.columns:
        st.markdown("**TCP Connection States**")
        tcp_df = df[df["protocol"] == "TCP"].dropna(subset=["tcp_flags"])
        
        # Determine state based on last seen flags for a connection pair
        connections = tcp_df.groupby(["src_ip", "dst_ip", "dst_port"]).last().reset_index()
        connections["State"] = "ESTABLISHED"
        connections.loc[connections["tcp_flags"].str.contains("F|R", na=False), "State"] = "CLOSED"
        connections.loc[connections["tcp_flags"] == "S", "State"] = "SYN_SENT"
        
        active_conns = connections[connections["State"] != "CLOSED"][["src_ip", "dst_ip", "dst_port", "State"]]
        if not active_conns.empty:
            st.dataframe(active_conns.head(10), use_container_width=True, hide_index=True)
        else:
            st.info("No active TCP connections.")

st.markdown("---")

# ── Charts ────────────────────────────────────────────────────────────────────
chart_col1, chart_col2 = st.columns(2)

with chart_col1:
    st.subheader("📈 Bandwidth Over Time")
    df_time = df.set_index("timestamp")
    bw_df = df_time["length"].resample("1s").sum().reset_index()
    bw_df.rename(columns={"length": "Bytes/sec"}, inplace=True)
    
    # 6. Bandwidth Spike Alert
    if not bw_df.empty:
        max_bw = bw_df["Bytes/sec"].max()
        if max_bw > 5_000_000: # 5 MB/s threshold
            st.error(f"⚠️ High Bandwidth Spike Detected: **{max_bw / 1024 / 1024:.2f} MB/s**")
            
    fig_bw = px.area(
        bw_df, x="timestamp", y="Bytes/sec",
        labels={"timestamp": "Time", "Bytes/sec": "Bandwidth (B/s)"},
    )
    fig_bw.update_traces(line=dict(color="#00C8FF", width=2), fillcolor="rgba(0,200,255,0.1)")
    fig_bw.update_layout(template="plotly_dark", margin=dict(l=0, r=0, t=30, b=0))
    st.plotly_chart(fig_bw, use_container_width=True)

with chart_col2:
    st.subheader("🥧 Protocol Distribution")
    proto_counts = df["protocol"].value_counts().reset_index()
    proto_counts.columns = ["Protocol", "Count"]
    fig_pie = px.pie(
        proto_counts, names="Protocol", values="Count", hole=0.45,
        color="Protocol",
        color_discrete_map={"TCP": "#636EFA", "UDP": "#EF553B", "ICMP": "#00CC96", "Other": "#AB63FA"},
    )
    fig_pie.update_layout(template="plotly_dark", margin=dict(l=0, r=0, t=30, b=0))
    st.plotly_chart(fig_pie, use_container_width=True)

st.markdown("---")

# ── Network Topology Graph ────────────────────────────────────────────────────
st.subheader("🕸️ Network Topology")
st.caption("Visualizing connections between internal and external IPs.")

# Create graph
G = nx.from_pandas_edgelist(df.head(1000), 'src_ip', 'dst_ip', edge_attr='protocol', create_using=nx.Graph())

if not G.nodes:
    st.info("Not enough data to build topology graph.")
else:
    # Fix #6: cache layout in session_state; only recompute when the node set changes
    node_fingerprint = frozenset(G.nodes())
    if st.session_state.get("topo_fingerprint") != node_fingerprint:
        st.session_state["topo_pos"] = nx.spring_layout(G, seed=42)
        st.session_state["topo_fingerprint"] = node_fingerprint
    pos = st.session_state["topo_pos"]
    
    edge_x = []
    edge_y = []
    for edge in G.edges():
        x0, y0 = pos[edge[0]]
        x1, y1 = pos[edge[1]]
        edge_x.extend([x0, x1, None])
        edge_y.extend([y0, y1, None])

    edge_trace = go.Scatter(
        x=edge_x, y=edge_y,
        line=dict(width=0.5, color='#888'),
        hoverinfo='none',
        mode='lines'
    )

    node_x = []
    node_y = []
    node_text = []
    node_size = []
    
    # Calculate degree for sizing
    degrees = dict(G.degree())
    
    for node in G.nodes():
        x, y = pos[node]
        node_x.append(x)
        node_y.append(y)
        node_text.append(f"IP: {node}<br>Connections: {degrees[node]}")
        # Scale size based on connections
        node_size.append(10 + (degrees[node] * 2))

    node_trace = go.Scatter(
        x=node_x, y=node_y,
        mode='markers+text',
        text=[n if degrees[n] > 5 else "" for n in G.nodes()], # Only label busy nodes
        textposition="bottom center",
        hoverinfo='text',
        hovertext=node_text,
        marker=dict(
            showscale=True,
            colorscale='YlGnBu',
            color=[degrees[n] for n in G.nodes()],
            size=node_size,
            colorbar=dict(title="Connections"),
            line_width=2
        )
    )

    fig_net = go.Figure(data=[edge_trace, node_trace],
                 layout=go.Layout(
                    showlegend=False,
                    hovermode='closest',
                    margin=dict(b=0,l=0,r=0,t=0),
                    plot_bgcolor='rgba(0,0,0,0)',
                    paper_bgcolor='rgba(0,0,0,0)',
                    xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
                    yaxis=dict(showgrid=False, zeroline=False, showticklabels=False))
                 )
    fig_net.update_layout(template="plotly_dark")
    st.plotly_chart(fig_net, use_container_width=True)

st.markdown("---")

# ── Top 5 Talkers ─────────────────────────────────────────────────────────────
st.subheader("🏆 Top 5 Talkers (Source IPs)")
top_talkers = (
